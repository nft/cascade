{
  "defaults": { "environment": "local", "credential": "" },
  "source": {
    "title": "demo-api",
    "version": "v1.4.0",
    "operations": [
      { "ref": "createUser", "method": "POST", "path": "/v1/users", "summary": "Create a user", "group": "Users" },
      { "ref": "getUser", "method": "GET", "path": "/v1/users/{id}", "summary": "Fetch a user", "group": "Users" },
      { "ref": "deleteUser", "method": "DELETE", "path": "/v1/users/{id}", "summary": "Delete a user", "group": "Users" },
      { "ref": "createOrg", "method": "POST", "path": "/v1/orgs", "summary": "Create an organization", "group": "Organizations" },
      { "ref": "inviteMember", "method": "POST", "path": "/v1/orgs/{id}/members", "summary": "Invite a member", "group": "Organizations" },
      { "ref": "createProject", "method": "POST", "path": "/v1/projects", "summary": "Create a project", "group": "Projects" },
      { "ref": "getProject", "method": "GET", "path": "/v1/projects/{id}", "summary": "Fetch a project", "group": "Projects" },
      { "ref": "patchProject", "method": "PATCH", "path": "/v1/projects/{id}", "summary": "Update a project", "group": "Projects" }
    ]
  },
  "environments": [
    { "name": "local", "baseUrl": "http://localhost:8080" },
    { "name": "staging", "baseUrl": "https://staging.api.example.com" },
    { "name": "prod-sandbox", "baseUrl": "https://sandbox.api.example.com" }
  ],
  "credentials": [
    { "name": "local-dev", "kind": "header", "header": "X-Api-Key", "createdAt": "2026-06-28" },
    { "name": "staging-admin", "kind": "bearer", "createdAt": "2026-07-01" },
    { "name": "sandbox-service", "kind": "basic", "username": "sandbox", "createdAt": "2026-07-02" }
  ],
  "collection": {
    "formatVersion": 1,
    "name": "Internal APIs",
    "root": {
      "id": "root",
      "name": "",
      "requests": [
        {
          "id": "health-check",
          "name": "Health check",
          "protocol": "http",
          "method": "GET",
          "url": "https://status.example.com/healthz"
        }
      ],
      "folders": [
        {
          "id": "billing",
          "name": "Billing",
          "requests": [
            {
              "id": "create-invoice",
              "name": "Create invoice",
              "protocol": "http",
              "method": "POST",
              "url": "/v1/invoices",
              "defaults": [
                { "key": "body.amount", "source": "literal", "value": "100" },
                { "key": "body.currency", "source": "literal", "value": "EUR" }
              ]
            },
            {
              "id": "invoice-events",
              "name": "Invoice events",
              "protocol": "ws",
              "url": "/v1/invoices/events"
            }
          ]
        }
      ]
    }
  },
  "board": {
    "formatVersion": 1,
    "name": "Main",
    "nodes": [
      {
        "id": "create-user",
        "type": "http",
        "name": "Create User",
        "data": {
          "key": "createUser",
          "method": "POST",
          "path": "/v1/users",
          "environment": "local",
          "credential": "",
          "repeat": 1,
          "fields": [
            { "key": "body.email", "source": "literal", "value": "ada@example.com" },
            { "key": "body.name", "source": "literal", "value": "Ada Lovelace" }
          ]
        }
      },
      {
        "id": "create-org",
        "type": "http",
        "name": "Create Org",
        "data": {
          "key": "createOrg",
          "method": "POST",
          "path": "/v1/orgs",
          "environment": "local",
          "credential": "",
          "repeat": 1,
          "fields": [
            { "key": "body.name", "source": "literal", "value": "Acme Inc" },
            { "key": "body.owner_id", "source": "binding", "value": "create-user.body.id", "ref": { "nodeId": "create-user", "path": "body.id" } }
          ]
        }
      },
      {
        "id": "invite-member",
        "type": "http",
        "name": "Invite Member",
        "data": {
          "key": "inviteMember",
          "method": "POST",
          "path": "/v1/orgs/{id}/members",
          "environment": "local",
          "credential": "",
          "repeat": 5,
          "fields": [
            { "key": "path.id", "source": "binding", "value": "create-org.body.id", "ref": { "nodeId": "create-org", "path": "body.id" } },
            { "key": "body.email", "source": "template", "value": "member+{{i}}@example.com" }
          ]
        }
      },
      {
        "id": "create-project",
        "type": "http",
        "name": "Create Project",
        "data": {
          "key": "createProject",
          "method": "POST",
          "path": "/v1/projects",
          "environment": "local",
          "credential": "",
          "repeat": 1,
          "fields": [
            { "key": "body.name", "source": "literal", "value": "Apollo" },
            { "key": "body.org_id", "source": "binding", "value": "create-org.body.id", "ref": { "nodeId": "create-org", "path": "body.id" } }
          ]
        }
      },
      {
        "id": "get-project",
        "type": "http",
        "name": "Get Project",
        "data": {
          "key": "getProject",
          "method": "GET",
          "path": "/v1/projects/{id}",
          "environment": "local",
          "credential": "",
          "repeat": 1,
          "fields": [
            { "key": "path.id", "source": "binding", "value": "create-project.body.id", "ref": { "nodeId": "create-project", "path": "body.id" } }
          ]
        }
      }
    ],
    "edges": [
      { "id": "e-user-org", "from": "create-user", "to": "create-org" },
      { "id": "e-org-invite", "from": "create-org", "to": "invite-member" },
      { "id": "e-org-project", "from": "create-org", "to": "create-project" },
      { "id": "e-project-get", "from": "create-project", "to": "get-project" }
    ],
    "layout": {
      "positions": {
        "create-user": { "x": 0, "y": 140 },
        "create-org": { "x": 300, "y": 140 },
        "invite-member": { "x": 620, "y": 260 },
        "create-project": { "x": 620, "y": 40 },
        "get-project": { "x": 950, "y": 40 }
      }
    }
  }
}
