// Inline sprite, referenced by `<use>`. Keeps the site free
// of an icon-font download for what amounts to a few hundred bytes of path data.
// Raw `<` lines are emitted verbatim, so nothing here may be interpolated.

def icon_sprite()
  <svg xmlns="http://www.w3.org/2000/svg" class="hidden" aria-hidden="true">
    <defs>
      <symbol id="icon-schema" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="5" rx="1.5"/>
        <rect x="14" y="3" width="7" height="5" rx="1.5"/>
        <rect x="8.5" y="16" width="7" height="5" rx="1.5"/>
        <path d="M6.5 8v3.5h11V8M12 11.5V16"/>
      </symbol>
      <symbol id="icon-binding" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="5" cy="5.5" r="2.5"/>
        <circle cx="19" cy="18.5" r="2.5"/>
        <path d="M7.4 6.6C11 9 13 12 16.6 16.4"/>
      </symbol>
      <symbol id="icon-dag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="9.5" width="7" height="5" rx="1.5"/>
        <rect x="14" y="3" width="7" height="5" rx="1.5"/>
        <rect x="14" y="16" width="7" height="5" rx="1.5"/>
        <path d="M10 12h2M12 5.5h2M12 18.5h2M12 5.5v13"/>
      </symbol>
      <symbol id="icon-fanout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="5" cy="12" r="2"/>
        <circle cx="19" cy="5" r="2"/>
        <circle cx="19" cy="12" r="2"/>
        <circle cx="19" cy="19" r="2"/>
        <path d="M6.9 11.3 17.1 5.7M7 12h10M6.9 12.7 17.1 18.3"/>
      </symbol>
      <symbol id="icon-logs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="3" width="16" height="18" rx="2"/>
        <path d="M8 8h8M8 12h8M8 16h5"/>
      </symbol>
      <symbol id="icon-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="10" width="16" height="10" rx="2"/>
        <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        <circle cx="12" cy="15" r="1.25" fill="currentColor" stroke="none"/>
      </symbol>
      <symbol id="icon-commit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3.5"/>
        <path d="M3 12h5.5M15.5 12H21"/>
      </symbol>
      <symbol id="icon-desktop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="12" rx="2"/>
        <path d="M8 20h8M12 16v4"/>
      </symbol>
      <symbol id="icon-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6"/>
      </symbol>
      <symbol id="icon-external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4h6v6M20 4l-8 8M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"/>
      </symbol>
      <symbol id="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </symbol>
      <symbol id="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="11" height="11" rx="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </symbol>
      <symbol id="icon-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5"/>
        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
      </symbol>
      <symbol id="icon-video" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2.5" y="5" width="14" height="14" rx="2.5"/>
        <path d="m16.5 10.5 5-3v9l-5-3"/>
        <path d="m8 9.5 4 2.5-4 2.5z"/>
      </symbol>
      <symbol id="icon-image" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="16" rx="2.5"/>
        <circle cx="8.5" cy="9.5" r="1.5"/>
        <path d="m4 17 4.5-4.5 3.5 3.5 3-3L20 18"/>
      </symbol>
      <symbol id="icon-play" viewBox="0 0 24 24" fill="currentColor" stroke="none">
        <path d="M8 5.4v13.2a.6.6 0 0 0 .92.5l10.3-6.6a.6.6 0 0 0 0-1L8.92 4.9a.6.6 0 0 0-.92.5Z"/>
      </symbol>
    </defs>
  </svg>

def icon(name box_class="size-5")
  svg(aria-hidden=true focusable=false) {box_class} shrink-0
    use(href="#icon-{name}")
