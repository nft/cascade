def doc_head(title description canonical base)
  head
    meta(charset=utf-8)
    meta(name=viewport content="width=device-width, initial-scale=1")
    title "{title}"
    meta(name=description content="{description}")
    meta(name=theme-color content="#09090b")
    meta(name=color-scheme content="dark")
    link(rel=canonical href={canonical})
    link(rel=icon type=image/svg+xml href=/favicon.svg)
    meta(property=og:type content=website)
    meta(property=og:title content="{title}")
    meta(property=og:description content="{description}")
    meta(property=og:url content={canonical})
    meta(property=og:site_name content=Cascade)
    meta(name=twitter:card content=summary)
    link(rel=stylesheet href=/src/style.css)
    script(type=module src=/src/main.ts)

def nav_link(href label external=false link_class="")
  if external
    a(href={href} target=_blank rel="noopener noreferrer") {link_class} inline-flex items-center gap-1.5
      | {label}
      +icon(name="external" box_class="size-3.5 opacity-50")
  else
    a(href={href}) {link_class} "{label}"

def site_header(links home_href toggle_ae panel_ae)
  header sticky top-0 z-50 border-b border-line/80 bg-canvas/85 backdrop-blur-md
    div mx-auto flex h-16 max-w-6xl items-center gap-4 px-5
      a(href={home_href} aria-label="Cascade home") flex items-center gap-2.5 text-ink
        +logo_mark(box_class="h-7")
        span text-[15px] font-semibold tracking-tight "Cascade"
      nav(aria-label="Main") ml-auto hidden items-center gap-6 md:flex
        for l in links
          +nav_link(href=l.href label=l.label external=l.external link_class="text-sm text-muted transition-colors hover:text-ink")
      button(type=button data-ae={toggle_ae} aria-expanded=false aria-controls=nav-panel aria-label="Toggle navigation") ml-auto grid size-9 place-items-center rounded-lg border border-line text-muted transition-colors hover:text-ink md:hidden
        +icon(name="menu" box_class="size-5")
    div(data-ae={panel_ae} hidden) #nav-panel border-t border-line bg-surface md:hidden
      nav(aria-label="Main, mobile") mx-auto flex max-w-6xl flex-col px-5 py-2
        for l in links
          +nav_link(href=l.href label=l.label external=l.external link_class="border-b border-line/60 py-3 text-sm text-muted last:border-0")

def site_footer(columns year repo_url repo_label license_name)
  footer mt-28 border-t border-line bg-surface
    div mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-3
      div flex flex-col gap-3
        span flex items-center gap-2.5 text-ink
          +logo_mark(box_class="h-6")
          span text-sm font-semibold tracking-tight "Cascade"
        p max-w-56 text-sm leading-relaxed text-faint
          | Realistic, connected test data for your own API.
      for col in columns
        div flex flex-col gap-3
          h2 text-xs font-semibold uppercase tracking-widest text-faint "{col.heading}"
          for l in col.links
            +nav_link(href=l.href label=l.label external=l.external link_class="text-sm text-muted transition-colors hover:text-ink")
    div border-t border-line/70
      div mx-auto flex max-w-6xl flex-col gap-2 px-5 py-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between
        p "{license_name} licensed. Copyright {year}"
        a(href={repo_url} target=_blank rel="noopener noreferrer") transition-colors hover:text-ink "{repo_label}"
