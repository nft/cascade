// Repeated building blocks only. Single-use section markup stays inline in the
// page that owns it.

def eyebrow(text)
  p text-xs font-semibold uppercase tracking-[0.18em] text-accent-soft "{text}"

def section_head(label title lede)
  div flex max-w-2xl flex-col gap-3
    +eyebrow(text={label})
    h2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl "{title}"
    p text-pretty leading-relaxed text-muted "{lede}"

def feature_card(title body icon_name)
  li group flex flex-col gap-3 rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-line/40 hover:bg-raised
    span grid size-10 place-items-center rounded-xl border border-line bg-raised text-accent-soft transition-colors group-hover:border-accent/40 group-hover:text-accent
      +icon(name={icon_name} box_class="size-5")
    h3 text-[15px] font-semibold tracking-tight "{title}"
    p text-sm leading-relaxed text-muted "{body}"

def step_row(index title body)
  li relative flex gap-5 border-t border-line pt-6
    span shrink-0 font-mono text-sm text-accent-soft "{index}"
    div flex flex-col gap-1.5
      h3 text-base font-semibold tracking-tight "{title}"
      p max-w-prose text-sm leading-relaxed text-muted "{body}"

def state_chip(label description swatch)
  li flex items-center gap-2.5
    span size-2 shrink-0 rounded-full {swatch}
    div flex flex-col leading-tight
      span text-xs font-medium "{label}"
      span text-xs text-faint "{description}"

def download_button(label detail href)
  li
    a(href={href} target=_blank rel="noopener noreferrer") group flex items-center gap-3 rounded-xl bg-accent px-5 py-3.5 text-white transition-colors hover:bg-accent-hover
      +icon(name="download" box_class="size-5")
      span flex flex-col leading-tight
        span text-sm font-semibold "{label}"
        span text-xs text-white/70 "{detail}"

// Stands in for artwork that has not been produced yet. The brief is rendered
// so whoever shoots the asset can read it straight off the page.
def media_placeholder(kind label caption brief)
  figure flex flex-col gap-2
    div flex flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-line bg-surface px-6 py-12 text-center
      span grid size-11 place-items-center rounded-xl border border-line bg-raised text-accent-soft
        +icon(name={kind} box_class="size-5")
      div flex flex-col gap-1
        span text-xs font-semibold uppercase tracking-widest text-faint "{label} to come"
        span text-sm font-medium "{caption}"
      p max-w-md text-xs leading-relaxed text-faint "{brief}"
    figcaption text-xs text-faint "{caption}"

def docs_callout(text)
  aside flex gap-3 rounded-xl border border-accent/30 bg-accent/5 px-4 py-3
    span mt-0.5 text-accent-soft
      +icon(name="lock" box_class="size-4")
    p text-sm leading-relaxed text-muted "{text}"

// A graph node on the demo canvas. Absolutely placed from the layout data, so
// its geometry is an inline custom style rather than a built class name.
def demo_node(node_id label method path binding repeat x y width height ae_name idle_class method_class)
  div(data-ae={ae_name} data-node-id={node_id} style="left:{x}px;top:{y}px;width:{width}px;height:{height}px") node {idle_class} absolute flex flex-col justify-center gap-1 rounded-xl border px-3
    div flex items-center gap-2
      span size-1.5 shrink-0 rounded-full node-dot
      span truncate text-xs font-semibold tracking-tight "{label}"
      span ml-auto font-mono text-[10px] text-faint "×{repeat}"
    div flex items-baseline gap-1.5 font-mono text-[10px]
      span shrink-0 font-semibold {method_class} "{method}"
      span truncate text-faint "{path}"
    p(title={binding}) truncate font-mono text-[10px] text-muted "{binding}"

def docs_nav_link(href label)
  li > a(href={href}) block rounded-lg px-3 py-1.5 text-sm text-muted transition-colors hover:bg-surface hover:text-ink "{label}"
