include ../partials/icons
include ../partials/layout
include ../partials/ui

doctype
html(lang=en) scroll-pt-20
  +doc_head(title="Cascade · Test data that actually hangs together" description=site.description canonical=canonical base=base)
  body antialiased
    +icon_sprite()
    +site_header(links=nav home_href=base toggle_ae=ae.navToggle panel_ae=ae.navPanel)

    main
      section relative overflow-hidden border-b border-line
        div absolute inset-0 grid-backdrop opacity-60
        div relative mx-auto flex max-w-3xl flex-col items-center gap-7 px-5 py-24 text-center sm:py-32
          span inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs text-muted
            span size-1.5 rounded-full bg-success
            | {hero.eyebrow}
          h1 text-balance text-4xl font-semibold leading-[1.08] tracking-tight sm:text-6xl "{hero.headline}"
          p max-w-2xl text-pretty leading-relaxed text-muted sm:text-lg "{hero.lede}"

          div flex flex-col items-stretch gap-3 sm:flex-row sm:items-center
            a(href={hero.primaryCta.href}) inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover
              | {hero.primaryCta.label}
              +icon(name="arrow" box_class="size-4")
            a(href={hero.secondaryCta.href} target=_blank rel="noopener noreferrer") inline-flex items-center justify-center gap-2 rounded-xl border border-line px-5 py-2.5 text-sm font-medium text-muted transition-colors hover:border-line/40 hover:text-ink
              | {hero.secondaryCta.label}
              +icon(name="external" box_class="size-3.5 opacity-60")

          div flex flex-col items-center gap-2
            div flex items-center gap-3 rounded-xl border border-line bg-surface py-2 pl-4 pr-2
              code truncate font-mono text-[13px] text-muted "{install.command}"
              button(type=button data-ae={ae.copyInstall} data-clipboard={install.command}) inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-line px-2.5 py-1.5 text-xs text-muted transition-colors hover:border-line/40 hover:text-ink
                +icon(name="copy" box_class="size-3.5")
                span(data-ae={ae.copyLabel} aria-live=polite) "Copy"
            p text-xs text-faint "{install.note}"

      section #demo border-b border-line
        div mx-auto flex max-w-6xl flex-col gap-8 px-5 py-20 sm:py-24
          +section_head(label="Live" title="Watch a graph cascade" lede="Press run. Each level fires only once everything it depends on has come back, and parallel branches advance together — the same order the engine schedules.")

          div flex flex-col gap-5 rounded-2xl border border-line bg-surface p-4 sm:p-6
            div flex flex-wrap items-center gap-3
              button(type=button data-ae={ae.runDemo}) inline-flex items-center gap-2 rounded-xl bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-hover aria-disabled:opacity-60
                +icon(name="play" box_class="size-3.5")
                | Run graph
              button(type=button data-ae={ae.resetDemo}) rounded-xl border border-line px-4 py-2 text-sm text-muted transition-colors hover:border-line/40 hover:text-ink "Reset"
              div ml-auto flex items-center gap-5
                span(data-ae={ae.demoStatus} aria-live=polite) text-sm text-muted "Ready"
                span flex items-baseline gap-1.5
                  span(data-ae={ae.demoCounter}) font-mono text-xl font-semibold tabular-nums "0"
                  span text-xs text-faint "records"

            div(tabindex=0 role=group aria-label="Example request graph") overflow-x-auto pb-1
              div(style="width:{demo.canvas.width}px;height:{demo.canvas.height}px") relative mx-auto
                svg(viewBox="0 0 {demo.canvas.width} {demo.canvas.height}" aria-hidden=true) absolute inset-0 size-full
                  for e in demo.edges
                    path(d={e.d} data-ae={ae.demoEdge} data-edge-id={e.id} fill=none stroke-width=1.75 stroke-linecap=round) edge
                for n in demo.nodes
                  +demo_node(node_id=n.id label=n.label method=n.method path=n.path binding=n.binding repeat=n.repeat x=n.x y=n.y width=demo.node.width height=demo.node.height ae_name=ae.demoNode idle_class=stateClass.idle method_class=n.methodClass)

            div grid gap-5 lg:grid-cols-3
              div flex flex-col gap-2.5 lg:col-span-2
                h3 text-xs font-semibold uppercase tracking-widest text-faint "Run log"
                div(data-ae={ae.demoLog}) flex min-h-[148px] flex-col gap-1.5
                  template
                    div flex items-center gap-3 rounded-lg border border-line/70 bg-canvas px-3 py-2 font-mono text-[11px]
                      span(data-ae={logPart.method}) w-8 shrink-0 font-semibold
                      span(data-ae={logPart.path}) truncate text-muted
                      span(data-ae={logPart.count}) ml-auto shrink-0 text-faint
                      span(data-ae={logPart.status}) shrink-0 font-semibold text-success
                      span(data-ae={logPart.duration}) w-14 shrink-0 text-right text-faint
              div flex flex-col gap-3 rounded-xl border border-line bg-canvas p-4
                h3 text-xs font-semibold uppercase tracking-widest text-faint "Node states"
                ul flex flex-col gap-2.5
                  for c in demo.chips
                    +state_chip(label=c.label description=c.description swatch=c.swatch)

      section #how border-b border-line
        div mx-auto flex max-w-6xl flex-col gap-10 px-5 py-20 sm:py-28
          +section_head(label="How it works" title="From an OpenAPI document to a seeded environment" lede="Cascade never guesses a request shape. Everything it sends is derived from the schema you gave it and the responses it has already collected.")
          ol flex flex-col gap-7
            for s in steps
              +step_row(index=s.index title=s.title body=s.body)

      section #features border-b border-line
        div mx-auto flex max-w-6xl flex-col gap-10 px-5 py-20 sm:py-28
          +section_head(label="Features" title="Built for data that has to line up" lede="Fixtures drift, seed scripts rot, and hand-copied ids break the moment a migration runs. Cascade keeps the relationships live.")
          ul grid gap-4 sm:grid-cols-2 lg:grid-cols-4
            for f in features
              +feature_card(title=f.title body=f.body icon_name=f.icon)

      section border-b border-line
        div mx-auto flex max-w-6xl flex-col gap-8 px-5 py-20
          +section_head(label="Under the hood" title="A Go engine in a native shell" lede="The engine is deliberately free of any UI dependency, so the same code can back the desktop app, a headless runner, and a server build.")
          ul grid gap-3 sm:grid-cols-2 lg:grid-cols-4
            for s in stack
              +stack_item(name=s.name role=s.role href=s.href)

      section
        div mx-auto flex max-w-3xl flex-col items-center gap-6 px-5 py-24 text-center
          h2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl "Stop hand-rolling seed scripts."
          p max-w-xl text-pretty leading-relaxed text-muted
            | Cascade is open source and in active development. Clone it, point it at a schema, and wire your first graph.
          div flex flex-col items-stretch gap-3 sm:flex-row
            a(href={site.repo} target=_blank rel="noopener noreferrer") inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover
              | Get the source
              +icon(name="external" box_class="size-3.5 opacity-70")
            a(href="{base}docs.html") rounded-xl border border-line px-5 py-2.5 text-sm font-medium text-muted transition-colors hover:border-line/40 hover:text-ink "Read the docs"

    +site_footer(columns=footer credits=siteStack year=year repo_url=site.repo repo_label=site.repoLabel license_name=site.license)
