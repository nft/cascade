include ../partials/icons
include ../partials/layout
include ../partials/ui

doctype
html(lang=en) scroll-pt-20
  +doc_head(title="Documentation · Cascade" description="How to run Cascade, the concepts behind the canvas, and the files it writes." canonical=canonical base=base)
  body antialiased
    +icon_sprite()
    +site_header(links=nav home_href=base toggle_ae=ae.navToggle panel_ae=ae.navPanel)

    main mx-auto grid max-w-6xl gap-12 px-5 py-16 lg:grid-cols-[210px_minmax(0,1fr)] sm:py-20
      aside hidden lg:block
        nav(aria-label="On this page") sticky top-24 flex flex-col gap-2
          p px-3 text-xs font-semibold uppercase tracking-widest text-faint "On this page"
          ul flex flex-col gap-0.5
            for s in docs.sections
              +docs_nav_link(href="#{s.id}" label=s.heading)

      div flex min-w-0 flex-col gap-14
        header flex flex-col gap-3
          +eyebrow(text="Documentation")
          h1 text-balance text-4xl font-semibold tracking-tight "Cascade documentation"
          p max-w-prose text-pretty leading-relaxed text-muted "{docs.intro}"

        for s in docs.sections
          section(id={s.id}) flex scroll-mt-24 flex-col gap-4
            h2 text-2xl font-semibold tracking-tight "{s.heading}"
            for para in s.paragraphs
              p max-w-prose text-pretty leading-relaxed text-muted "{para}"
            if s.media
              +media_placeholder(kind=s.media.kind label=s.media.label caption=s.media.caption brief=s.media.brief)
            if s.callout
              +docs_callout(text=s.callout)
            if s.bullets
              ul flex max-w-prose flex-col gap-2
                for b in s.bullets
                  li flex gap-2.5 text-sm leading-relaxed text-muted
                    span shrink-0 text-accent-soft "—"
                    span "{b}"

        section flex flex-col gap-4 rounded-2xl border border-line bg-surface p-6
          h2 text-lg font-semibold tracking-tight "Still stuck?"
          p max-w-prose text-sm leading-relaxed text-muted
            | If something is not behaving the way this page describes, it is worth reporting — Cascade is early, and a description of what you were doing is usually enough to get it fixed.
          div flex flex-wrap gap-3
            a(href="{site.repo}/issues" target=_blank rel="noopener noreferrer") inline-flex items-center gap-2 rounded-xl border border-line px-4 py-2 text-sm text-muted transition-colors hover:border-line/40 hover:text-ink
              | Report a problem
              +icon(name="external" box_class="size-3.5 opacity-60")
            a(href="{base}#download") inline-flex items-center gap-2 rounded-xl bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-hover
              +icon(name="download" box_class="size-4")
              | Download Cascade

    +site_footer(columns=footer year=year repo_url=site.repo repo_label=site.repoLabel license_name=site.license)
