{
  "_comment": [
    "Run-target closures, shared by core/graph_test.go (Graph.Closure) and",
    "frontend/src/lib/graph.test.ts (runSet, its port). Both sides must give",
    "exactly `expect`: the canvas paints its set on the click and the engine's",
    "run.started only confirms it, so a divergence would leave nodes the run",
    "never touches painted, or ones it does touch still wearing last run's",
    "status. Containment is carried by node.parent, never by edges."
  ],
  "graphs": {
    "chain": {
      "nodes": [{ "id": "a" }, { "id": "b" }, { "id": "c" }],
      "edges": [
        { "from": "a", "to": "b" },
        { "from": "b", "to": "c" }
      ]
    },
    "diamond": {
      "nodes": [{ "id": "a" }, { "id": "b" }, { "id": "c" }, { "id": "d" }],
      "edges": [
        { "from": "a", "to": "b" },
        { "from": "a", "to": "c" },
        { "from": "b", "to": "d" },
        { "from": "c", "to": "d" }
      ]
    },
    "split": {
      "nodes": [{ "id": "a" }, { "id": "b" }, { "id": "x" }, { "id": "y" }],
      "edges": [
        { "from": "a", "to": "b" },
        { "from": "x", "to": "y" }
      ]
    },
    "loop": {
      "nodes": [
        { "id": "seed", "type": "mock" },
        { "id": "loop", "type": "for" },
        { "id": "c1", "parent": "loop" },
        { "id": "c2", "parent": "loop" },
        { "id": "after" }
      ],
      "edges": [
        { "from": "seed", "to": "loop" },
        { "from": "c1", "to": "c2" },
        { "from": "loop", "to": "after" }
      ]
    },
    "loneChild": {
      "nodes": [
        { "id": "seed", "type": "mock" },
        { "id": "loop", "type": "for" },
        { "id": "solo", "parent": "loop" },
        { "id": "after" }
      ],
      "edges": [
        { "from": "seed", "to": "loop" },
        { "from": "loop", "to": "after" }
      ]
    },
    "island": {
      "nodes": [
        { "id": "loop", "type": "for" },
        { "id": "c1", "parent": "loop" },
        { "id": "c2", "parent": "loop" }
      ],
      "edges": [{ "from": "c1", "to": "c2" }]
    },
    "twoLoops": {
      "nodes": [
        { "id": "l1", "type": "for" },
        { "id": "a1", "parent": "l1" },
        { "id": "a2", "parent": "l1" },
        { "id": "l2", "type": "for" },
        { "id": "b1", "parent": "l2" }
      ],
      "edges": [
        { "from": "a1", "to": "a2" },
        { "from": "l1", "to": "l2" }
      ]
    }
  },
  "cases": [
    { "graph": "chain", "target": "b", "scope": "upstream", "expect": ["a", "b"] },
    { "graph": "chain", "target": "b", "scope": "downstream", "expect": ["b", "c"] },
    { "graph": "chain", "target": "b", "scope": "component", "expect": ["a", "b", "c"] },
    { "graph": "chain", "target": "a", "scope": "upstream", "expect": ["a"] },
    { "graph": "chain", "target": "c", "scope": "downstream", "expect": ["c"] },

    { "graph": "diamond", "target": "d", "scope": "upstream", "expect": ["a", "b", "c", "d"] },
    { "graph": "diamond", "target": "a", "scope": "downstream", "expect": ["a", "b", "c", "d"] },
    { "graph": "diamond", "target": "b", "scope": "upstream", "expect": ["a", "b"] },
    { "graph": "diamond", "target": "b", "scope": "downstream", "expect": ["b", "d"] },
    { "graph": "diamond", "target": "b", "scope": "component", "expect": ["a", "b", "c", "d"] },

    { "graph": "split", "target": "a", "scope": "component", "expect": ["a", "b"] },
    { "graph": "split", "target": "x", "scope": "upstream", "expect": ["x"] },
    { "graph": "split", "target": "y", "scope": "component", "expect": ["x", "y"] },

    {
      "note": "including a for pulls in its body — a loop runs as a unit",
      "graph": "loop",
      "target": "loop",
      "scope": "upstream",
      "expect": ["c1", "c2", "loop", "seed"]
    },
    {
      "graph": "loop",
      "target": "loop",
      "scope": "downstream",
      "expect": ["after", "c1", "c2", "loop"]
    },
    {
      "note": "targeting a child promotes to its container: a loop child has no meaning outside its iteration",
      "graph": "loop",
      "target": "c1",
      "scope": "downstream",
      "expect": ["after", "c1", "c2", "loop"]
    },
    {
      "graph": "loop",
      "target": "c2",
      "scope": "upstream",
      "expect": ["c1", "c2", "loop", "seed"]
    },
    {
      "graph": "loop",
      "target": "c2",
      "scope": "component",
      "expect": ["after", "c1", "c2", "loop", "seed"]
    },
    {
      "graph": "loop",
      "target": "after",
      "scope": "upstream",
      "expect": ["after", "c1", "c2", "loop", "seed"]
    },
    {
      "graph": "loop",
      "target": "seed",
      "scope": "downstream",
      "expect": ["after", "c1", "c2", "loop", "seed"]
    },
    {
      "note": "a node outside the loop is unaffected by containment",
      "graph": "loop",
      "target": "seed",
      "scope": "upstream",
      "expect": ["seed"]
    },
    { "graph": "loop", "target": "c1", "scope": "upstream", "expect": ["c1", "c2", "loop", "seed"] },
    { "graph": "loop", "target": "c1", "scope": "component", "expect": ["after", "c1", "c2", "loop", "seed"] },

    {
      "note": "a child with no edges of its own still reaches through its container",
      "graph": "loneChild",
      "target": "solo",
      "scope": "downstream",
      "expect": ["after", "loop", "solo"]
    },
    { "graph": "loneChild", "target": "solo", "scope": "upstream", "expect": ["loop", "seed", "solo"] },

    {
      "note": "a loop with no outside edges: the body's own edges never reach the container",
      "graph": "island",
      "target": "c2",
      "scope": "upstream",
      "expect": ["c1", "c2", "loop"]
    },
    { "graph": "island", "target": "c1", "scope": "downstream", "expect": ["c1", "c2", "loop"] },

    {
      "note": "promotion walks the container's edges, so the next loop comes whole",
      "graph": "twoLoops",
      "target": "a1",
      "scope": "downstream",
      "expect": ["a1", "a2", "b1", "l1", "l2"]
    },
    { "graph": "twoLoops", "target": "b1", "scope": "upstream", "expect": ["a1", "a2", "b1", "l1", "l2"] },
    {
      "note": "an included loop brings its own body, never an upstream loop's",
      "graph": "twoLoops",
      "target": "l2",
      "scope": "downstream",
      "expect": ["b1", "l2"]
    }
  ]
}
